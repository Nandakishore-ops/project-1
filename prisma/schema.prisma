datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  phone          String?
  address        String?
  headline       String?
  summary        String?
  avatar         String?
  username       String          @unique
  template       String          @default("modern-developer")
  accentColor    String          @default("indigo")
  theme          String          @default("dark")
  isPublic       Boolean         @default(true)
  github         String?
  linkedin       String?
  twitter        String?
  portfolioUrl   String?
  leetcode       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  educations     Education[]
  skills         Skill[]
  projects       Project[]
  experiences    Experience[]
  certifications Certification[]
  achievements   Achievement[]
}

model Education {
  id         String   @id @default(cuid())
  userId     String
  college    String
  degree     String
  branch     String?
  cgpa       String?
  startYear  String
  endYear    String
  coursework String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String   // "technical", "languages", "soft", "tools"
  level     String?  // "Beginner", "Intermediate", "Proficient", "Expert"
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String
  technologies String   // JSON array or comma separated
  githubUrl    String?
  liveUrl      String?
  featured     Boolean  @default(false)
  highlights   String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Experience {
  id           String   @id @default(cuid())
  userId       String
  role         String
  company      String
  location     String?
  type         String   @default("Internship") // Internship, Full-time, Freelance
  startDate    String
  endDate      String?  // "Present" or date
  description  String?
  technologies String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certification {
  id            String   @id @default(cuid())
  userId        String
  name          String
  issuer        String
  issueDate     String?
  credentialUrl String?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  date        String?
  link        String?
  category    String?  // Hackathon, Academic, Coding, Leadership
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
